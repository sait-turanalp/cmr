# Bu dosya örnektir — gerçek .env'i install.sh oluşturur veya elle doldur
CMR_DOMAIN=cmr.example.com
CMR_EMAIL=admin@example.com
PUBLIC_URL=https://cmr.example.com

API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
CORS_DOMAIN=https://cmr.example.com
REDIS_URL=redis://redis:6379/0
JOBS_BACKEND=redis
PDF_MAX_AGE_HOURS=2
PARALLEL_WORKERS=3
PARALLEL_MIN_ROWS=100
MAX_ROWS_PER_REQUEST=2000

NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_24
NEXTAUTH_URL=https://cmr.example.com
NEXT_PUBLIC_API_URL=https://cmr.example.com
NEXT_PUBLIC_API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
